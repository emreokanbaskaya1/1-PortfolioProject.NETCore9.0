@model List<Education>
@{
    ViewData["Title"] = "Education Management";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Education Management</h5>
        <a href="/Education/Create" class="btn btn-primary">
            <i class="ti ti-plus"></i> Add Education
        </a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>School Name</th>
                        <th>Department</th>
                        <th>Start Year</th>
                        <th>End Year</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var education in Model)
                    {
                        <tr>
                            <td>@education.SchoolName</td>
                            <td>@education.Department</td>
                            <td>@education.StartYear</td>
                            <td>@(education.EndYear ?? "Present")</td>
                            <td>@(education.Description?.Length > 50 ? education.Description.Substring(0, 50) + "..." : education.Description)</td>
                            <td>
                                <a href="/Education/Update/@education.EducationId" class="btn btn-sm btn-warning">
                                    <i class="ti ti-edit"></i>
                                </a>
                                <a href="/Education/Delete/@education.EducationId" class="btn btn-sm btn-danger" 
                                   onclick="return confirm('Are you sure you want to delete this education?')">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted">No education records found.</p>
                <a href="/Education/Create" class="btn btn-primary">Add First Education</a>
            </div>
        }
    </div>
</div>
