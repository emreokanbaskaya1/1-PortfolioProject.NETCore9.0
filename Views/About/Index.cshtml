@model About
@{
    ViewData["Title"] = "About Me Settings";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>About Me Settings</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group mb-3">
                <label>Profile Image URL:</label>
                <input type="text" class="form-control" asp-for="ImageUrl" 
                       placeholder="https://example.com/profile.jpg" />
            </div>

            <div class="form-group mb-3">
                <label>Title:</label>
                <input type="text" class="form-control" asp-for="Title" 
                       placeholder="Software Developer" required />
            </div>

            <div class="form-group mb-3">
                <label>Description:</label>
                <textarea class="form-control" asp-for="Description" rows="4" 
                          placeholder="Brief description about yourself..." required></textarea>
            </div>

            <div class="form-group mb-3">
                <label>Birth Date:</label>
                <input type="date" class="form-control" asp-for="BirthDate" />
            </div>

            <div class="form-group mb-3">
                <label>Website:</label>
                <input type="url" class="form-control" asp-for="WebSite" 
                       placeholder="https://example.com" />
            </div>

            <div class="form-group mb-3">
                <label>Phone Number:</label>
                <input type="tel" class="form-control" asp-for="PhoneNumber" 
                       placeholder="+90 555 123 4567" />
            </div>

            <div class="form-group mb-3">
                <label>City:</label>
                <input type="text" class="form-control" asp-for="City" 
                       placeholder="Istanbul" />
            </div>

            <div class="form-group mb-3">
                <label>Graduation:</label>
                <input type="text" class="form-control" asp-for="Graduation" 
                       placeholder="Computer Science" />
            </div>

            <div class="form-group mb-3">
                <label>Email:</label>
                <input type="email" class="form-control" asp-for="Email" 
                       placeholder="john@example.com" required />
            </div>

            <div class="form-group mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="IsAvailable" />
                    <label class="form-check-label">Available for Work</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/Statistics/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
