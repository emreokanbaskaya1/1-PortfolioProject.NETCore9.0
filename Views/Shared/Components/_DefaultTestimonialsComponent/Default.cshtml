@model List<Testimonial>
<!-- Testimonials Section -->
<section id="testimonials" class="testimonials section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Testimonials</h2>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        @if (Model != null && Model.Any())
        {
            <div class="swiper init-swiper">
                <script type="application/json" class="swiper-config">
                    {
                      "loop": true,
                      "speed": 600,
                      "autoplay": {
                        "delay": 5000
                      },
                      "slidesPerView": "auto",
                      "pagination": {
                        "el": ".swiper-pagination",
                        "type": "bullets",
                        "clickable": true
                      }
                    }
                </script>
                <div class="swiper-wrapper">

                    @foreach (var testimonial in Model)
                    {
                        <div class="swiper-slide">
                            <div class="testimonial-item">
                                <img src="@(string.IsNullOrEmpty(testimonial.ImageUrl) ? "~/Kelly-1.0.0/assets/img/testimonials/testimonials-1.jpg" : testimonial.ImageUrl)" class="testimonial-img" alt="@testimonial.Name">
                                <h3>@testimonial.Name</h3>
                                <h4>@testimonial.Title</h4>
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= testimonial.Review)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </div>
                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>@testimonial.Comment</span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    }

                </div>
                <div class="swiper-pagination"></div>
            </div>
        }
        else
        {
            <div class="text-center">
                <p class="text-muted">No testimonials available yet.</p>
                <p class="text-muted">Please add testimonials through the admin panel.</p>
            </div>
        }

    </div>

</section><!-- /Testimonials Section -->
