
@model Banner
@*
    Hero component view for displaying a title and subtitle.
*@

<section id="hero" class="hero section">

    <img src="@(Model?.CoverImageUrl ?? "~/Kelly-1.0.0/assets/img/hero-bg.jpg")" alt="" data-aos="fade-in">

    <div class="container text-center" data-aos="zoom-out" data-aos-delay="100">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);">@(Model?.NameSurname ?? "Your Name")</h2>
                <p class="text-white" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.7);">@(Model?.Title ?? "I'm a professional developer")</p>
                <a href="#about" class="btn-get-started">About Me</a>
            </div>
        </div>
    </div>

</section><!-- /Hero Section -->
<!-- End Hero -->