@model Experience
@{
    ViewData["Title"] = "Add Experience";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Add Experience</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group mb-3">
                <label>Title:</label>
                <input type="text" class="form-control" asp-for="Title" 
                       placeholder="Software Developer" required />
            </div>

            <div class="form-group mb-3">
                <label>Company:</label>
                <input type="text" class="form-control" asp-for="Company" 
                       placeholder="Company Name" required />
            </div>

            <div class="form-group mb-3">
                <label>City:</label>
                <input type="text" class="form-control" asp-for="City" 
                       placeholder="Istanbul" required />
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label>Start Year:</label>
                        <input type="number" class="form-control" asp-for="StartYear" 
                               min="1950" max="@DateTime.Now.Year" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label>Start Month:</label>
                        <select class="form-control" asp-for="StartMonth">
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label>End Year:</label>
                        <input type="number" class="form-control" asp-for="EndYear" 
                               min="1950" max="@(DateTime.Now.Year + 10)" 
                               placeholder="Leave empty if current job" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label>End Month:</label>
                        <select class="form-control" asp-for="EndMonth">
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label>Description:</label>
                <textarea class="form-control" asp-for="Description" rows="4" 
                          placeholder="Describe your role and responsibilities..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Add Experience</button>
            <a href="/Experience/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
