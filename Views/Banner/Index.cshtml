@model Banner
@{
    ViewData["Title"] = "Banner Settings";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Banner Settings</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group mb-3">
                <label>Cover Image URL:</label>
                <input type="text" class="form-control" asp-for="CoverImageUrl" 
                       placeholder="https://example.com/image.jpg" />
            </div>

            <div class="form-group mb-3">
                <label>Name Surname:</label>
                <input type="text" class="form-control" asp-for="NameSurname" 
                       placeholder="John Doe" required />
            </div>

            <div class="form-group mb-3">
                <label>Title:</label>
                <input type="text" class="form-control" asp-for="Title" 
                       placeholder="Software Developer" required />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/Statistics/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
